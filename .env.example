# Template for local settings. Copy it to .env and set your own values:
#   Copy-Item .env.example .env
# .env is git-ignored (it holds secrets); this file is committed (it holds no secrets).

# Used by Docker Compose to create the database (compose.yaml)
BEST_PRACTICE_MAIN_DB_NAME=best_practice
BEST_PRACTICE_MAIN_DB_USERNAME=best_practice
BEST_PRACTICE_MAIN_DB_PASSWORD=change-me

# Used by Spring Boot to connect (application.properties). Port 6969 matches compose.yaml.
BEST_PRACTICE_MAIN_DB=jdbc:postgresql://localhost:6969/best_practice
